{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=bookify;Username=postgres;Password=postgres;",
    //"Cache": "bookify-redis:6379",
    "Cache": "localhost:6379"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://bookify-seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Authentication": {
    "Audience": "account",
    "ValidIssuer": "http://localhost:8080/realms/Bookify-Realm",
    "MetadataUrl": "http://localhost:8080/realms/Bookify-Realm/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Keycloak": {
    "BaseUrl": "http://localhost:8080",
    "AdminUrl": "http://localhost:8080/admin/realms/Bookify-Realm/",
    "TokenUrl": "http://localhost:8080/realms/Bookify-Realm/protocol/openid-connect/token",
    "AdminClientId": "bookify-admin-client",
    "AdminClientSecret": "WxK7AvKI4FGUMebFBlvF8AgGbNStyhEv",
    "AuthClientId": "bookify-auth-client",
    "AuthClientSecret": "9xMvvYZ4XznKtl37ExHwOhyxoFNISR31"
  },
  "Outbox": {
    "IntervalInSeconds": 10,
    "BatchSize": 10
  }
}